DATABASE_URL=postgresql+psycopg://ppc:ppc@localhost:5432/ppc
DATA_DIR=./data
API_FIXTURES=0
# Docker stack (docker-compose.yml). Use a real secret on the server.
POSTGRES_PASSWORD=ppc
HTTP_PORT=8080
# Access key (decision 0087). Empty = ppc-api generates one at every start and logs it:
#   docker compose logs ppc-api | grep "access key"
# Set a fixed key on the server (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
# PPC_AUTH=off disables the key (local only). Never commit a real key.
PPC_ACCESS_KEY=
PPC_AUTH=on
# Resource caps (shared production host). API_CPUS: whole number, also sets the BLAS/OpenMP threads.
API_CPUS=4
API_MEM_LIMIT=8g
DB_CPUS=1
DB_MEM_LIMIT=1g
WEB_CPUS=0.5
WEB_MEM_LIMIT=256m
LIVE_POLL_S=300
# Must be enabled by a human, see decision 0003
AMPWHERE_ENABLED=0
# Only if PPC provides a feed. Never commit the values.
PPC_FEED_URL=
PPC_FEED_TOKEN=
VITE_API_URL=http://localhost:8000
# Server (behind Traefik, decision 0066): uncomment and fill in.
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
# TRAEFIK_NETWORK=traefik
# PPC_HOST=ppc.example.com
# TRAEFIK_ENTRYPOINT=websecure
# COMPOSE_PROFILES=live

# Docker stack: host folder with the private data (data/processed, data/raw/live)
DATA_HOST_DIR=./data
# Live demo clock (decision 0072): empty = real time
LIVE_CLOCK_START=
LIVE_CLOCK_SPEED=1
# live signals: mock (PPC Blue intents + Maps counts sampled from F0 rates, decision 0070) or off (decision 0084)
LIVE_SIGNALS=mock

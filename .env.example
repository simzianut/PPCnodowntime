DATABASE_URL=postgresql+psycopg://ppc:ppc@localhost:5432/ppc
DATA_DIR=./data
API_FIXTURES=0
# Docker stack (docker-compose.yml). Use a real secret on the server.
POSTGRES_PASSWORD=ppc
HTTP_PORT=8080
LIVE_POLL_S=300
# Must be enabled by a human, see decision 0003
AMPWHERE_ENABLED=0
# Only if PPC provides a feed. Never commit the values.
PPC_FEED_URL=
PPC_FEED_TOKEN=
VITE_API_URL=http://localhost:8000
# Server (behind Traefik, decision 0066): uncomment and fill in.
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
# TRAEFIK_NETWORK=traefik
# PPC_HOST=ppc.example.com
# TRAEFIK_ENTRYPOINT=websecure
# COMPOSE_PROFILES=live

# data that must never be committed (spec 00 §3)
data/raw/
data/interim/
data/processed/
.env
.env.*
!.env.example
!.env.train.example

# training runs (decision 0051)
runs/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# frontend
node_modules/
frontend/dist/

# os / editors
.DS_Store
.idea/
.vscode/

# LaTeX figures: keep built outputs in docs/figures/build, ignore aux files
!docs/figures/build/
docs/figures/**/*.aux
docs/figures/**/*.log
docs/figures/**/*.dvi

# training outputs on the GPU server (docker/train_forecasters.sh)
logs/
forecaster_results_*.tar.gz
ppc_cloud_*.tar.gz
f2_v2_results_*.tar.gz

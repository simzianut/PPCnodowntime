# Training on the GPU server (decision 0051). Copy to .env next to docker-compose.train.yml.
# Host GPU index exactly as `nvidia-smi` shows it. The container sees only this GPU, as cuda:0.
GPU_ID=0
# Code version baked into the image and every run manifest (the server copy has no .git).
GIT_SHA=unknown
GIT_DIRTY=false
# Keeps these containers apart from other compose projects on the server.
COMPOSE_PROJECT_NAME=ppctrain
